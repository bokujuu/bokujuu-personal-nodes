{
  "1": {
    "class_type": "VHS_LoadVideoPath",
    "inputs": {
      "video": "C:\\path\\to\\input.mp4",
      "force_rate": 30,
      "custom_width": 320,
      "custom_height": 180,
      "frame_load_cap": 16,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "3": {
    "class_type": "BokujuuDLSS5TemporalUpscale",
    "inputs": {
      "images": ["1", 0],
      "scale": 2.0,
      "quality": "balanced",
      "cas_amount": 0.7,
      "output_mix": 1.0,
      "scene_cut_threshold": 0.35,
      "gpu_index": 0
    }
  },
  "4": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["3", 0],
      "frame_rate": 30,
      "loop_count": 0,
      "filename_prefix": "bokujuu_dlss5/temporal_2x",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true,
      "audio": ["1", 2]
    }
  }
}
